# ---------------------------------------------------------------------------
# Copy to .env (or .env.local) and fill in. Never commit real values.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database (Postgres) ----------------------------------------------------
# Payload stores all content here. Local:  postgres://ecc:ecc@127.0.0.1:5432/ecc
# Production: a managed Postgres (Neon, Supabase, RDS…), pooled connection URL.
#
# Leave unset and the site still builds and renders, entirely from the seeded
# copy in src/lib/content/site.ts — useful for CI and design work.
DATABASE_URI=

# Signs admin sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# In development the schema is pushed automatically. Production applies the
# committed migrations instead (npm run migrate). Set to false to disable push
# in development too.
# PAYLOAD_DB_PUSH=false

# --- Site ---------------------------------------------------------------------
# Canonical URLs, sitemap, Open Graph and the Payload server URL.
#   Local:      http://localhost:3000
#   Production: https://ecc-group.ae
# A *.vercel.app origin is treated as staging and closed to crawlers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only if a *.vercel.app URL really is the public site.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Extra hosts allowed to serve images through next/image, comma separated —
# e.g. the old WordPress uploads while content is being migrated.
# NEXT_PUBLIC_IMAGE_HOSTS=ecc-group.ae

# --- Media storage ------------------------------------------------------------
# On Vercel the filesystem is read-only: uploads go to Vercel Blob when this is
# set (Storage → Blob → token). Locally, uploads are written to ./media.
# BLOB_READ_WRITE_TOKEN=

# --- Email (form notifications, password resets) -------------------------------
# Without SMTP, Payload logs emails to the console instead of sending them.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@ecc-group.ae

# --- First run ------------------------------------------------------------------
# `npm run seed` creates this admin user if there are no users yet.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# --- WordPress import (one-off, see docs/seo-migration.md) ----------------------
# WORDPRESS_URL=https://ecc-group.ae
# RANKMATH=true
# IMPORT_PAGES=true
